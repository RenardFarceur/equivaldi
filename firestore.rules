rules_version = '2';
// Règles d'accès EquiValdi : plusieurs écuries, chacune séparée des autres.
// À coller dans Firebase › Firestore Database › Règles, puis « Publier ».
// Chaque cas autorisé est une ligne « allow » à part : un cas qui ne s'applique pas ne bloque jamais les autres.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Outils ----------
    function connecte() { return request.auth != null && request.auth.token.email_verified == true; }
    function moi() { return request.auth.uid; }
    function mail() { return request.auth.token.email.lower(); }
    function maintenant() { return request.time.toMillis(); }
    function structure(sid) { return /databases/$(database)/documents/structures/$(sid); }
    function fiche(sid, uid) { return /databases/$(database)/documents/structures/$(sid)/membres/$(uid); }
    function invitation(code) { return /databases/$(database)/documents/invitations/$(code); }
    function ancienne(uid) { return /databases/$(database)/documents/membres/$(uid); }
    // un champ absent ou vide
    function absent(m, champ) { return !(champ in m) || m[champ] == null; }
    function touche(champs) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(champs); }
    function seulement(champs) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs); }
    // un texte d'au plus n caractères (champ facultatif : absent ou vide accepté)
    function texte(m, champ, n) { return !(champ in m) || (m[champ] is string && m[champ].size() <= n); }
    // une date notée maintenant (à un jour près, pour les horloges de téléphone décalées)
    function dateMaintenant(v) { return v is int && v > maintenant() - 86400000 && v < maintenant() + 86400000; }
    function donnees() { return ['chevaux', 'soins', 'pres', 'places', 'entretiens', 'foin', 'concours', 'seances', 'taches', 'config']; }

    // Dans une écurie : membre (sa fiche existe), éditrice (gérante ou « Peut modifier »), gérante (celle de la structure)
    function membre(sid) { return connecte() && exists(fiche(sid, moi())); }
    // l'équipe (gérante, « Peut modifier », « Lecture seule ») : tout le carnet. Un « Propriétaire » est membre,
    // mais ne lit que les fiches partagées de ses chevaux et ses relevés (partages, releves).
    function equipier(sid) { return connecte() && get(fiche(sid, moi())).data.role in ['gerante', 'equipe', 'lecture']; }
    function editeur(sid) { return connecte() && get(fiche(sid, moi())).data.role in ['gerante', 'equipe']; }
    function gerante(sid) { return connecte() && get(structure(sid)).data.gerante == moi(); }

    // Administration EquiValdi : gère toutes les écuries sans en être membre (n'apparaît dans aucune équipe)
    function admin() { return connecte() && mail() == 'bennizdu03@gmail.com'; }

    // Écurie active : essai en cours, abonnement payé, ou à vie (fondatrice, ou créée avant le 6 novembre 2026 à 12 h)
    function actif(sid) {
      let s = get(structure(sid)).data;
      let a = s.get('abonnement', {});
      return a.get('statut', '') in ['fondatrice', 'a_vie']
        || s.get('creeLe', 9999999999999) < 1793962800000
        || (a.get('statut', '') == 'abonnee' && a.get('fin', 0) > maintenant())
        || a.get('finEssai', 0) > maintenant();
    }
    // Une écurie se crée maintenant (pas d'ancienne date pour passer « à vie »)
    function creeeMaintenant() {
      return request.resource.data.creeLe is int
        && request.resource.data.creeLe > maintenant() - 86400000
        && request.resource.data.creeLe < maintenant() + 86400000;
    }
    // Paiement de démonstration (en attendant Shine ou Tebex) : abonnement d'un mois ou d'un an,
    // sans toucher à l'essai. À retirer quand le vrai paiement sera branché.
    function paiementFictif(avant, a) {
      return a.get('statut', '') == 'abonnee'
        && a.get('formule', '') in ['mois', 'an']
        && a.get('paiement', {}).get('fournisseur', '') == 'fictif'
        && a.get('fin', 0) is int && a.get('fin', 0) <= maintenant() + 800 * 86400000
        && a.get('finEssai', 0) == avant.get('finEssai', 0)
        && a.get('debut', 0) == avant.get('debut', 0);
    }

    // Ancien carnet (avant les écuries) : ses membres le lisent encore, personne n'y écrit
    function ancienMembre() { return connecte() && exists(ancienne(moi())); }
    function ancienneGerante() { return connecte() && get(ancienne(moi())).data.role == 'gerante'; }

    // Fiche de membre : les trois façons d'entrer dans une écurie
    // (a) sa propre fiche de gérante, dans le lot qui crée l'écurie
    function creationEcurie(sid, uid) {
      return uid == moi()
        && request.resource.data.role == 'gerante'
        && request.resource.data.email == mail()
        && !exists(structure(sid))
        && getAfter(structure(sid)).data.gerante == moi();
    }
    // (b) sa propre fiche, grâce à une invitation : même écurie, même rôle, valable, utilisée une seule fois
    function invitationOk(sid, code) {
      let inv = get(invitation(code)).data;
      return inv.structure == sid
        && inv.role == request.resource.data.role
        && inv.role in ['equipe', 'lecture', 'proprio']
        && absent(inv, 'utiliseePar')
        && (absent(inv, 'expire') || inv.expire > maintenant())
        && (absent(inv, 'email') || inv.email == mail())
        && getAfter(invitation(code)).data.utiliseePar == moi();
    }
    function viaInvitation(sid, uid) {
      return uid == moi()
        && ('via' in request.resource.data)
        && request.resource.data.via is string
        && request.resource.data.email == mail()
        && invitationOk(sid, request.resource.data.via);
    }
    // (c) migration : la gérante de l'ancien carnet recopie la fiche d'un de ses membres, avec le même rôle
    function recopie(sid, uid) {
      return uid != moi()
        && gerante(sid)
        && ancienneGerante()
        && exists(ancienne(uid))
        && request.resource.data.role == get(ancienne(uid)).data.role
        && request.resource.data.role in ['equipe', 'lecture'];
    }

    // ---------- Index personnel : la liste de mes écuries ----------
    match /utilisateurs/{uid} {
      allow read, write: if connecte() && uid == moi();
    }

    // ---------- Écuries ----------
    match /structures/{sid} {
      allow read: if membre(sid);
      allow read, update: if admin();
      // création : par soi, gérante de sa nouvelle écurie, en essai de 2 mois au plus
      allow create: if connecte()
        && request.resource.data.gerante == moi()
        && request.resource.data.creePar.uid == moi()
        && request.resource.data.nom is string
        && request.resource.data.nom.size() >= 2 && request.resource.data.nom.size() <= 40
        && creeeMaintenant()
        && request.resource.data.abonnement.keys().hasOnly(['statut', 'debut', 'finEssai'])
        && request.resource.data.abonnement.statut == 'essai'
        && request.resource.data.abonnement.finEssai is int
        && request.resource.data.abonnement.finEssai <= maintenant() + 63 * 86400000;
      // « fondatrice » : seulement la première écurie, celle de Célia (migration de l'ancien carnet)
      allow create: if connecte()
        && request.resource.data.gerante == moi()
        && request.resource.data.creePar.uid == moi()
        && request.resource.data.nom is string
        && request.resource.data.nom.size() >= 2 && request.resource.data.nom.size() <= 40
        && creeeMaintenant()
        && request.resource.data.abonnement.statut == 'fondatrice'
        && mail() == 'celiacourtois8@gmail.com';
      // mise à jour : la gérante, sans toucher à l'abonnement ; la gérance ne passe qu'à un membre existant
      allow update: if gerante(sid)
        && !touche(['abonnement', 'creePar', 'creeLe'])
        && (request.resource.data.gerante == resource.data.gerante
            || exists(fiche(sid, request.resource.data.gerante)));
      // la gérante abonne son écurie (paiement de démonstration) : seul l'abonnement change
      allow update: if gerante(sid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abonnement'])
        && paiementFictif(resource.data.get('abonnement', {}), request.resource.data.abonnement);
      // dernière ouverture de l'écurie (pour l'administration) : tout membre, ce seul champ, la date du jour
      allow update: if membre(sid) && seulement(['vu']) && dateMaintenant(request.resource.data.vu);
      // la gérante supprime son écurie (suppression de son compte quand elle y est seule : l'appli le vérifie)
      allow delete: if gerante(sid);

      // ---------- L'équipe de l'écurie ----------
      match /membres/{uid} {
        allow read: if equipier(sid);
        // un propriétaire lit sa fiche et celle de la gérante (pour la joindre)
        allow get: if membre(sid) && (uid == moi() || uid == get(structure(sid)).data.gerante);
        allow read, write: if admin();
        allow create: if connecte() && creationEcurie(sid, uid);
        allow create: if connecte() && viaInvitation(sid, uid);
        allow create: if connecte() && recopie(sid, uid);
        // la gérante modifie toutes les fiches. Personne ne devient gérante sans que structures.gerante
        // le désigne dans le même lot, et la gérante ne se retire ce rôle qu'en passant la gérance.
        allow update: if gerante(sid)
          && (request.resource.data.role != 'gerante' || getAfter(structure(sid)).data.gerante == uid)
          && (uid != moi() || request.resource.data.role == 'gerante' || getAfter(structure(sid)).data.gerante != moi());
        // chacun tient sa fiche (prénom, téléphone, bons…), sans toucher à son rôle ni à son adresse
        allow update: if connecte() && uid == moi() && !touche(['role', 'email']);
        // la gérante retire quelqu'un (pas elle-même) ; chacun peut quitter, sauf la gérante
        allow delete: if gerante(sid) && uid != moi();
        allow delete: if connecte() && uid == moi() && get(structure(sid)).data.gerante != moi();
        // la gérante retire sa propre fiche seulement avec l'écurie, dans le même lot
        allow delete: if uid == moi() && gerante(sid) && !existsAfter(structure(sid));
      }

      // ---------- Pension : ce que voit chaque propriétaire ----------
      // une fiche par cheval (sa fiche, ses soins, séances, concours, où il est), tenue à jour par l'équipe
      match /partages/{hid} {
        allow read: if equipier(sid);
        allow get, list: if membre(sid) && resource.data.proprio == moi();
        allow write: if editeur(sid) && (request.resource == null || request.resource.data.proprio is string);
        allow read, write: if admin();
      }
      // les relevés mensuels : préparés et envoyés par la gérante, lus par leur propriétaire
      match /releves/{rid} {
        allow read: if equipier(sid);
        allow get, list: if membre(sid) && resource.data.proprio == moi();
        allow write: if gerante(sid);
        allow read, write: if admin();
      }

      // ---------- Le carnet de l'écurie ----------
      // écrire demande une écurie active : après l'essai sans abonnement, elle reste lisible
      match /{coll}/{id} {
        allow read: if coll in donnees() && equipier(sid);
        allow write: if coll in donnees() && editeur(sid) && actif(sid);
        // la gérante vide le carnet avant de supprimer l'écurie, même après l'essai
        allow delete: if coll in donnees() && gerante(sid);
        allow read, write: if coll in donnees() && admin();
      }
    }

    // ---------- Invitations (par lien ou par adresse e-mail) ----------
    match /invitations/{code} {
      allow read, write: if admin();
      // le code est le secret : toute personne connectée qui le connaît peut lire l'invitation
      // (pas les anciennes invitations, rangées sous l'adresse e-mail, qui n'a rien de secret)
      allow get: if connecte() && (resource == null || resource.data.structure is string);
      // listes : celles de mon adresse ; celles de mon écurie (gérante) ; l'ancien format, pour la migration
      allow list: if connecte() && resource.data.email == mail();
      allow list: if gerante(resource.data.structure);
      allow list: if ancienneGerante() && resource.data.par == moi();
      allow create: if connecte()
        && request.resource.data.structure is string
        && gerante(request.resource.data.structure)
        && request.resource.data.role in ['equipe', 'lecture', 'proprio']
        && absent(request.resource.data, 'utiliseePar')
        && ((('email' in request.resource.data) && request.resource.data.email is string)
            || (request.resource.data.expire is int && request.resource.data.expire <= maintenant() + 8 * 86400000));
      // la gérante (sans changer d'écurie ni marquer l'invitation utilisée)
      allow update: if resource.data.structure is string
        && gerante(resource.data.structure)
        && !touche(['structure', 'utiliseePar']);
      // l'invitée : seulement utiliseePar = soi et utiliseeLe, avec sa fiche créée dans le même lot
      allow update: if connecte()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['utiliseePar', 'utiliseeLe'])
        && absent(resource.data, 'utiliseePar')
        && request.resource.data.utiliseePar == moi()
        && (absent(resource.data, 'expire') || resource.data.expire > maintenant())
        && (absent(resource.data, 'email') || resource.data.email == mail())
        && !exists(fiche(resource.data.structure, moi()))
        && existsAfter(fiche(resource.data.structure, moi()));
      allow delete: if resource.data.structure is string && gerante(resource.data.structure);
    }

    // ---------- « Une idée, un souci ? » : messages à EquiValdi ----------
    // chacun écrit les siens et lit les réponses ; l'administration lit, répond et classe
    match /retours/{id} {
      allow read, update, delete: if admin();
      allow get, list: if connecte() && resource.data.uid == moi();
      allow create: if connecte()
        && request.resource.data.uid == moi()
        && request.resource.data.keys().hasOnly(['uid', 'nom', 'email', 'sid', 'ecurie', 'role', 'type', 'texte', 'version', 'appareil', 'le', 'statut'])
        && request.resource.data.type in ['idee', 'souci', 'question']
        && request.resource.data.texte is string && request.resource.data.texte.size() >= 3 && request.resource.data.texte.size() <= 2000
        && request.resource.data.statut == 'nouveau'
        && dateMaintenant(request.resource.data.le)
        && texte(request.resource.data, 'nom', 60) && texte(request.resource.data, 'email', 120)
        && texte(request.resource.data, 'sid', 40) && texte(request.resource.data, 'ecurie', 60)
        && texte(request.resource.data, 'role', 20) && texte(request.resource.data, 'version', 30)
        && texte(request.resource.data, 'appareil', 200);
      // la personne marque la réponse lue
      allow update: if connecte() && resource.data.uid == moi() && seulement(['vuLe']) && request.resource.data.vuLe is int;
      // et efface ses messages (suppression de son compte)
      allow delete: if connecte() && resource.data.uid == moi();
    }

    // ---------- Ancien carnet (racine) : lecture seule pour ses membres ----------
    match /membres/{uid} {
      allow read: if ancienMembre();
      allow get: if connecte() && uid == moi();
    }
    match /{coll}/{id} {
      allow read: if coll in donnees() && ancienMembre();
      // seule exception : l'ancienne gérante note que la mise à jour est faite, vers une écurie qu'elle gère
      allow create, update: if coll == 'config' && id == 'migration'
        && ancienneGerante()
        && request.resource.data.structure is string
        && gerante(request.resource.data.structure);
    }
  }
}
// ---------- fin des règles EquiValdi : cette ligne doit être la dernière de l'éditeur ----------
